# Skaidrāka veidne ar vietturiem: supabase.env.template → nokopē kā .env.local
#
# Supabase projekts -> Settings -> API
# Kopē uz .env.local (nesūti uz Git)

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Absolūtā lappuses sakne (e-pasta apstiprinājums OAuth, signUp callback).
# Lokāli parasti:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Umami (cloud.umami.is) – tikai production; ielādējas pēc analītikas sīkdatņu piekrišanas
NEXT_PUBLIC_UMAMI_WEBSITE_ID=98c05ca2-62dc-4c4d-8100-9d32729f02d8

# Serverim (pēc SQL 023: signup_email_exists RPC); NEVIS klientam.
# Logo (/admin/system): nav obligāts – pietiek admin sesija + 072_brand_storage.sql.
# Obligāti serverī (signup, VIP, logo): Supabase Dashboard → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
