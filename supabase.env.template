# =============================================================================
# 1) Nokopē šo failu uz projekta sakni ar nosaukumu:  .env.local
#    (PowerShell:  Copy-Item supabase.env.template .env.local )
# 2) Aizstāj <...> vietturus ar īstajām vērtībām no Supabase.
# 3) Pārstartē: npm run dev
#
# Kur ņemt vērtības: Supabase Dashboard → Project Settings → API
# =============================================================================

# Obligāti – projekta URL (piem. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=<IEVIETO_SUPABASE_PROJECT_URL>

# Obligāti – Publishable / anon atslēga
NEXT_PUBLIC_SUPABASE_ANON_KEY=<IEVIETO_ANON_PUBLIC_KEY>

# Obligāti serverī pēc SQL 023: signup e-pasts, admin VIP RPC, logo (/admin/system).
# Pēc SQL 116: Pro trial RPC (grant/repair) – tikai ar service_role no servera.
# Dashboard → Project Settings → API → service_role (secret). Nekad nepublicē repo / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=<IEVIETO_SERVICE_ROLE_KEY>

# Lappuses sakne – e-pasta apstiprinājumiem un OAuth atgriešanai
# Lokāli:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Produkcijā (Vercel): https://repazy.com

# Drošības smoke (H2 + system_settings; ja URL/anon nav - izlaidums):
# npm run security:smoke
# SECURITY_SMOKE_EMAIL=
# SECURITY_SMOKE_PASSWORD=

# Proxy rate-limit opcijas (`proxy.ts` → `auth-rate-limit`):
# DISABLE_RATE_LIMIT=false
# RATE_LIMIT_MULTIPLIER=1
# Globāls skaitītājs vairākām Vercel instancēm (opcija):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# E-pasti (Resend API; skat. /admin/email-design):
# RESEND_API_KEY=
# EMAIL_FROM=SubTrack <noreply@tavs-domens.lv>
#   – reģistrācija (confirm_signup) un aizmirstā parole (reset_password), UI valoda; kavētie (cron)
#   – vajag arī SUPABASE_SERVICE_ROLE_KEY (generateLink bez Supabase Auth template e-pasta)
# CRON_SECRET=  # Authorization: Bearer <CRON_SECRET> uz /api/cron/* (bez ?secret= URL)
#   – /api/cron/overdue-payment-emails (e-pasts)
#   – /api/cron/payment-push-notifications (PWA push: kavētie + šodien)

# Web Push (PWA paziņojumi tālrunī; ģenerēt: npx web-push generate-vapid-keys):
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@tavs-domens.lv

