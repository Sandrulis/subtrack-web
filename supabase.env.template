# =============================================================================
# 1) Nokopē šo failu uz projekta sakni ar nosaukumu:  .env.local
#    (PowerShell:  Copy-Item supabase.env.template .env.local )
# 2) Aizstāj <...> vietturus ar īstajām vērtībām no Supabase.
# 3) Pārstartē: npm run dev
#
# Kur ņemt vērtības: Supabase Dashboard → Project Settings → API
# =============================================================================

# Obligāti – projekta URL (piem. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=<IEVIETO_SUPABASE_PROJECT_URL>

# Obligāti – Publishable / anon atslēga
NEXT_PUBLIC_SUPABASE_ANON_KEY=<IEVIETO_ANON_PUBLIC_KEY>

# Lappuses sakne – e-pasta apstiprinājumiem un OAuth atgriešanai
# Lokāli:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Produkcijā nomaini uz: https://tavs-domēns.lv

# Nav obligāti šim Next auth plūsmai (tikai admin/server skriptiem vēlāk):
# SUPABASE_SERVICE_ROLE_KEY=<NEKAD_neievieto_frontendā>

# Skriptam `npm run security:smoke-users-rls` (H2; ja lauki tukši - izlaidums):
# SECURITY_SMOKE_EMAIL=
# SECURITY_SMOKE_PASSWORD=

# Proxy rate-limit opcijas (`proxy.ts` → `auth-rate-limit`):
# DISABLE_RATE_LIMIT=false
# RATE_LIMIT_MULTIPLIER=1

