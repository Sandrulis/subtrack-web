{
  "name": "subtrack-web",
  "version": "0.3.41",
  "private": true,
  "scripts": {
    "dev": "concurrently -p none \"serwist build --watch\" \"next dev\"",
    "dev:next-only": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build && serwist build",
    "start": "next start",
    "lint": "eslint",
    "audit": "npm audit --audit-level=high",
    "security:smoke-users-rls": "node scripts/security-smoke-users-rls.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.11",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }
}
