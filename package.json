{
  "name": "subtrack-web",
  "version": "0.4.49",
  "private": true,
  "scripts": {
    "dev": "concurrently -p none \"serwist build --watch\" \"next dev\"",
    "dev:next-only": "next dev",
    "dev:webpack": "next dev --webpack",
    "css:split": "node scripts/split-landing-css.mjs",
    "build": "node scripts/split-landing-css.mjs && next build && serwist build",
    "start": "next start",
    "lint": "eslint",
    "audit": "npm audit --audit-level=high",
    "security:migration-checklist": "node scripts/security-migration-checklist.mjs",
    "security:deploy-checklist": "node scripts/security-deploy-checklist.mjs",
    "security:verify-migrations": "node scripts/security-verify-migrations.mjs",
    "security:regression-check": "node scripts/security-regression-check.mjs",
    "security:smoke-users-rls": "node scripts/security-smoke-users-rls.mjs",
    "security:smoke-system-settings": "node scripts/security-smoke-system-settings.mjs",
    "security:smoke": "npm run security:smoke-system-settings && npm run security:smoke-users-rls",
    "security:check": "npm run security:regression-check && npm run audit && npm run security:smoke"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.55.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "stripe": "^22.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.11",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }
}
